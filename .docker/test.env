# Docker only
PROJECT_NAME="italystrap-settings"
# The package folder in the container, the fixtures URLs use it
PACKAGE_SLUG="settings"
PHP_VERSION="8.2"
WP_VERSION="6.8"

WP_PORT=8968

# Docker and Codeception
DB_NAME="test"
DB_HOST="mysql"
DB_USER="root"
DB_PASSWORD="root"
TABLE_PREFIX="wp_"
# WPLoader drops and installs its tables, keep them apart from the site of the container
INTEGRATION_TABLE_PREFIX="int_"

# Codeception, paths and hosts are the ones inside the container of the core
WP_ROOT_FOLDER="/var/www/html"
WP_URL="http://wordpress"
WP_DOMAIN="wordpress"
ADMIN_EMAIL="admin@wordpress.test"
