{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src"]
    },
    "logs": {
        "text": "tests/_output/infection.log",
        "github": true
    },
    "tmpDir": "tests/_output",
    "timeout": 10,
    // The floor with the 0.0.x classes, the new ones have 100%, raised to 100 by #8
    "minMsi": 48,
    "minCoveredMsi": 92,
    "mutators": {
        "@default": true,
        // Any version below 1 runs all the steps, the missing version is 0 only to name it
        "DecrementInteger": {
            "ignore": ["ItalyStrap\\Settings\\Migrator::storedVersion"]
        }
    },
    "testFramework": "codeception",
    "testFrameworkOptions": "--skip=integration"
}
